# Copy this file to .env and fill in your values.

# Required — API keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional — Document metadata defaults (shown as pre-filled values in the sidebar)
# Change these so you don't have to retype them on every run.
SENDER_NAME=Your Name
SENDER_TITLE=Your Job Title
COMPANY=Your Company Name
RECIPIENT_NAME=Recipient Name
EMAIL_SUBJECT=Feedback – Session Title
FEEDBACK_CONTEXT=Brief context of what the recording is about
